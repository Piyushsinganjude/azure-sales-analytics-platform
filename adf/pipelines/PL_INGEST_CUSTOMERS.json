{
  "name": "PL_INGEST_CUSTOMERS",
  "properties": {
    "description": "Copies the GlobalMart customers CSV file from the ADLS Gen2 raw landing area to the customers ingestion destination.",
    "activities": [
      {
        "name": "Copy_Customers",
        "type": "Copy",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "source": {
            "type": "DelimitedTextSource",
            "storeSettings": {
              "type": "AzureBlobFSReadSettings",
              "recursive": false,
              "enablePartitionDiscovery": false
            },
            "formatSettings": {
              "type": "DelimitedTextReadSettings"
            }
          },
          "sink": {
            "type": "DelimitedTextSink",
            "storeSettings": {
              "type": "AzureBlobFSWriteSettings"
            },
            "formatSettings": {
              "type": "DelimitedTextWriteSettings",
              "quoteAllText": true,
              "fileExtension": ".csv"
            }
          },
          "enableStaging": false,
          "translator": {
            "type": "TabularTranslator",
            "typeConversion": true,
            "typeConversionSettings": {
              "allowDataTruncation": true,
              "treatBooleanAsNumber": false
            }
          }
        },
        "inputs": [
          {
            "referenceName": "DS_GENERIC_SOURCE",
            "type": "DatasetReference"
          }
        ],
        "outputs": [
          {
            "referenceName": "DS_GENERIC_SINK",
            "type": "DatasetReference"
          }
        ]
      }
    ],
    "annotations": [
      "GlobalMart",
      "Raw ingestion",
      "Portfolio project"
    ]
  }
}
